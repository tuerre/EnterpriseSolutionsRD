generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model categories {
  category_id   Int        @id @default(autoincrement())
  category_name String     @unique @db.VarChar(100)
  is_active     Boolean?   @default(true)
  products      products[]
}

model departments {
  dept_id     Int         @id @default(autoincrement())
  name        String      @unique @db.VarChar(100)
  description String?
  is_active   Boolean?    @default(true)
  employees   employees[]
}

model employees {
  employee_id Int          @id @default(autoincrement())
  first_name  String       @db.VarChar(100)
  last_name   String       @db.VarChar(100)
  email       String       @unique @db.VarChar(120)
  id_card     String       @unique @db.VarChar(20)
  dept_id     Int?
  salary      Decimal      @default(0) @db.Decimal(12, 2)
  is_active   Boolean?     @default(true)
  created_at  DateTime?    @default(now()) @db.Timestamp(6)
  departments departments? @relation(fields: [dept_id], references: [dept_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_employee_dept")
  users       users?
}

model modules {
  module_id        Int                @id @default(autoincrement())
  name             String             @unique @db.VarChar(100)
  description      String?
  permissions      permissions[]
  system_movements system_movements[]
}

model permissions {
  permission_id Int      @id @default(autoincrement())
  role_id       Int
  module_id     Int
  can_read      Boolean? @default(false)
  can_insert    Boolean? @default(false)
  can_update    Boolean? @default(false)
  can_delete    Boolean? @default(false)
  modules       modules  @relation(fields: [module_id], references: [module_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_permission_module")
  roles         roles    @relation(fields: [role_id], references: [role_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_permission_role")

  @@unique([role_id, module_id], map: "uq_role_module")
}

model products {
  product_id       Int                @id @default(autoincrement())
  product_name     String             @db.VarChar(150)
  description      String?
  category_id      Int
  supplier_id      Int
  tax_id           Int
  cost_price       Decimal            @db.Decimal(12, 2)
  sale_price       Decimal            @db.Decimal(12, 2)
  stock            Int                @default(0)
  aisle_location   String?            @db.VarChar(50)
  is_active        Boolean?           @default(true)
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  categories       categories         @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_product_cat")
  suppliers        suppliers          @relation(fields: [supplier_id], references: [supplier_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_product_supp")
  tax_types        tax_types          @relation(fields: [tax_id], references: [tax_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_product_tax")
  purchase_details purchase_details[]
  sale_details     sale_details[]
}

model purchase_details {
  detail_id   Int       @id @default(autoincrement())
  purchase_id Int
  product_id  Int
  quantity    Int
  products    products  @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_detailpurch_product")
  purchases   purchases @relation(fields: [purchase_id], references: [purchase_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_detailpurch_purch")
}

model purchases {
  purchase_id      Int                @id @default(autoincrement())
  supplier_id      Int
  purchase_date    DateTime?          @default(now()) @db.Timestamp(6)
  total_amount     Decimal            @db.Decimal(15, 2)
  purchase_details purchase_details[]
  suppliers        suppliers          @relation(fields: [supplier_id], references: [supplier_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_purchase_supp")
}

model roles {
  role_id     Int           @id @default(autoincrement())
  role_name   String        @unique @db.VarChar(50)
  description String?
  is_active   Boolean?      @default(true)
  permissions permissions[]
  users       users[]
}

model sale_details {
  detail_id  Int      @id @default(autoincrement())
  sale_id    Int
  product_id Int
  quantity   Int
  unit_price Decimal  @db.Decimal(15, 2)
  products   products @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_detailsale_product")
  sales      sales    @relation(fields: [sale_id], references: [sale_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_detailsale_sale")
}

model sales {
  sale_id        Int            @id @default(autoincrement())
  invoice_number String         @unique @db.VarChar(50)
  sale_date      DateTime?      @default(now()) @db.Timestamp(6)
  user_id        Int
  subtotal       Decimal        @default(0) @db.Decimal(15, 2)
  taxes          Decimal        @default(0) @db.Decimal(15, 2)
  total_final    Decimal        @default(0) @db.Decimal(15, 2)
  payment_method String?        @db.VarChar(50)
  sale_details   sale_details[]
  users          users          @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sale_user")
}

model suppliers {
  supplier_id  Int         @id @default(autoincrement())
  company_name String      @db.VarChar(150)
  tax_id       String?     @unique @db.VarChar(20)
  contact_name String?     @db.VarChar(100)
  phone        String?     @db.VarChar(20)
  email        String?     @db.VarChar(150)
  address      String?
  is_active    Boolean?    @default(true)
  products     products[]
  purchases    purchases[]
}

model system_movements {
  movement_id  Int       @id @default(autoincrement())
  module_id    Int
  user_id      Int
  reference_id Int?
  action_type  String    @db.VarChar(50)
  amount       Decimal?  @db.Decimal(12, 2)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  notes        String?
  modules      modules   @relation(fields: [module_id], references: [module_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_mov_module")
  users        users     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_mov_user")
}

model tax_types {
  tax_id     Int        @id @default(autoincrement())
  name       String     @db.VarChar(50)
  percentage Decimal    @db.Decimal(5, 2)
  products   products[]
}

model users {
  user_id          Int                @id @default(autoincrement())
  employee_id      Int?               @unique
  username         String             @unique @db.VarChar(50)
  password         String             @db.VarChar(255)
  role_id          Int
  is_active        Boolean?           @default(true)
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  sales            sales[]
  system_movements system_movements[]
  employees        employees?         @relation(fields: [employee_id], references: [employee_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_employee")
  roles            roles              @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_role")
}
